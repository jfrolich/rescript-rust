+// Calls, inline bytes, Vec requests/bytes, String requests/bytes, Box requests/bytes.
+fn descriptor_vec<T>(v: &[T], n: &mut [u64; 8]) {
+    if !v.is_empty() { n[2] += 1; n[3] += std::mem::size_of_val(v) as u64; }
+}
+fn descriptor_string(s: &str, n: &mut [u64; 8]) {
+    if !s.is_empty() { n[4] += 1; n[5] += s.len() as u64; }
+}
+fn descriptor_box<T>(n: &mut [u64; 8]) { n[6] += 1; n[7] += std::mem::size_of::<T>() as u64; }
+fn descriptor_lid(lid: &crate::parser::longident::Longident, n: &mut [u64; 8]) {
+    use crate::parser::longident::Longident;
+    match lid {
+        Longident::Lident(_) => (),
+        Longident::Ldot(p, _) => { descriptor_box::<Longident>(n); descriptor_lid(p, n); }
+        Longident::Lapply(a, b) => {
+            descriptor_box::<Longident>(n); descriptor_lid(a, n);
+            descriptor_box::<Longident>(n); descriptor_lid(b, n);
+        }
+    }
+}
+fn descriptor_clone_cost(d: &TypeDesc) -> (&'static str, [u64; 8]) {
+    let mut n = [0; 8]; n[0] = 1; n[1] = std::mem::size_of::<TypeDesc>() as u64;
+    let variant = match d {
+        TypeDesc::Tvar(s) => { if let Some(s) = s { descriptor_string(s, &mut n); } "Tvar" }
+        TypeDesc::Tunivar(s) => { if let Some(s) = s { descriptor_string(s, &mut n); } "Tunivar" }
+        TypeDesc::Tarrow { args, .. } => {
+            descriptor_vec(args, &mut n);
+            for a in args { match a.label() {
+                ArgLabel::Nolabel => (),
+                ArgLabel::Labelled(l) | ArgLabel::Optional(l) => {
+                    descriptor_box::<ArgLabel>(&mut n); descriptor_string(&l.txt, &mut n);
+                }
+            }} "Tarrow"
+        }
+        TypeDesc::Ttuple(v) => { descriptor_vec(v, &mut n); "Ttuple" }
+        TypeDesc::Tconstr { args, .. } => { descriptor_vec(args, &mut n); "Tconstr" }
+        TypeDesc::Tobject { name, .. } => {
+            if let Some((_, v)) = name { descriptor_vec(v, &mut n); } "Tobject"
+        }
+        TypeDesc::Tfield { name, .. } => { descriptor_string(name, &mut n); "Tfield" }
+        TypeDesc::Tnil => "Tnil",
+        TypeDesc::Tlink(_) => "Tlink",
+        TypeDesc::Tsubst(_) => "Tsubst",
+        TypeDesc::Tvariant(row) => {
+            descriptor_vec(&row.row_fields, &mut n);
+            for (_, field) in &row.row_fields {
+                if let RowField::Reither { types, .. } = field { descriptor_vec(types, &mut n); }
+            }
+            if let Some((_, v)) = &row.row_name { descriptor_vec(v, &mut n); } "Tvariant"
+        }
+        TypeDesc::Tpoly { vars, .. } => { descriptor_vec(vars, &mut n); "Tpoly" }
+        TypeDesc::Tpackage { lids, args, .. } => {
+            descriptor_vec(lids, &mut n); descriptor_vec(args, &mut n);
+            for lid in lids { descriptor_lid(lid, &mut n); } "Tpackage"
+        }
+    };
+    (variant, n)
+}
+impl Drop for TypeContext {
+    fn drop(&mut self) {
+        let rows = self.descriptor_probe.take();
+        // One stderr lock per context prevents interleaved records. No shared counters.
+        use std::io::Write;
+        let stderr = std::io::stderr(); let mut out = stderr.lock();
+        writeln!(out, "DESC_CONTEXT {}", rows.len()).unwrap();
+        for ((file, line, col, variant), n) in rows {
+            writeln!(out, "DESC_SNAPSHOT\t{}\t{}\t{}\t{}\t{:?}", file, line, col, variant, n).unwrap();
+        }
+    }
+}
