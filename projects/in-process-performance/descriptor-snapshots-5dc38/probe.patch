+        let desc = self.types.get(r).desc();
+        let caller = std::panic::Location::caller();
+        let (variant, costs) = descriptor_clone_cost(&desc);
+        let mut counters = self.descriptor_probe.take();
+        let row = counters.entry((caller.file(), caller.line(), caller.column(), variant)).or_default();
+        for (total, n) in row.iter_mut().zip(costs) { *total += n; }
+        self.descriptor_probe.set(counters);
+        TypeDescSnapshot(desc.clone())
