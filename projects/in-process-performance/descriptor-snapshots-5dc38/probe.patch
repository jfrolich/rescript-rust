     /// Returns a cloned snapshot to avoid RefCell borrow conflicts when
     /// the desc is held across function calls that may modify the same node.
     #[inline]
+    #[track_caller]
     pub fn get_desc(&self, r: TypeExprRef) -> TypeDescSnapshot {
