+    #[test]
+    fn snapshot_projection_lower_args_alias_lookup_order() {
+        use crate::types::TypeArg;
+        let ctx = TypeContext::new(std::sync::Arc::new(IdGenerator::new()));
+        let mut env = Env::empty();
+        let module_id = Ident::create_local("M");
+        let path = Path::pdot(Path::pident(module_id.clone()), "t".to_string());
+        let int = ctx.new_constr(crate::types::predef::path_int(), vec![]);
+        env.add_module(module_id, module_with_t(Ident::create_local("t"), manifest_decl(int, Some(path.clone()))));
+        let arg = ctx.new_constr(path.clone(), vec![]);
+        ctx.set_level(arg, ctx.current_level() + 10);
+        let ret = ctx.new_var(None);
+        let arrow = ctx.new_type(TypeDesc::Tarrow { args: vec![TypeArg::unlabeled(arg)], ret });
+        let alias_id = Ident::create_local("function_alias");
+        env.add_type(alias_id.clone(), manifest_decl(arrow, None));
+        let alias = ctx.new_constr(Path::pident(alias_id), vec![]);
+        let (lookups, expansions) = lower_args(&ctx, &env, alias);
+        assert_eq!(lookups.len(), 1);
+        assert!(lookups[0].same(&path));
+        assert_eq!(expansions.len(), 2);
+        assert!(expansions[0].same(&path));
+        assert!(expansions[1].same(&crate::types::predef::path_int()), "{:?}", expansions);
+        ctx.set_desc(arg, TypeDesc::Tnil);
+        ctx.set_desc(arrow, TypeDesc::Tnil);
+    }
