+    #[test]
+    fn snapshot_projection_owned_nary_stages_preserve_metadata() {
+        use crate::types::{ArgLabel, TypeArg};
+        use crate::location::{Location, Position};
+        use crate::intern::StrIdx;
+        let ctx = TypeContext::new(std::sync::Arc::new(IdGenerator::new()));
+        let shared = ctx.new_generic_var(Some("shared".into()));
+        let loc = Location {
+            loc_start: Position::new(StrIdx(11), 2, 7, 9),
+            loc_end: Position::new(StrIdx(12), 3, 17, 21),
+            loc_ghost: true,
+        };
+        let arrow = ctx.new_generic_type(TypeDesc::Tarrow {
+            args: vec![TypeArg::unlabeled(shared),
+                TypeArg::new(ArgLabel::labelled("named", loc), shared),
+                TypeArg::new(ArgLabel::optional("optional", loc), shared)], ret: shared,
+        });
+        let (declared, declared_ret) = {
+            let desc = ctx.borrow_desc(arrow);
+            let TypeDesc::Tarrow { args, ret } = &*desc else { panic!("arrow") };
+            (args.clone(), *ret)
+        };
+        let instanced = instance(&ctx, arrow);
+        let (mut parameters, ret) = {
+            let desc = ctx.borrow_desc(instanced);
+            let TypeDesc::Tarrow { args, ret } = &*desc else { panic!("instance arrow") };
+            (args.clone(), *ret)
+        };
+        ctx.set_desc(arrow, TypeDesc::Tnil);
+        ctx.set_desc(instanced, TypeDesc::Tnil);
+        assert_eq!(declared_ret, shared);
+        assert_ne!(ret, shared);
+        for (stage, expected_type) in [(&declared, shared), (&parameters, ret)] {
+            assert_eq!(stage.len(), 3);
+            assert!(matches!(stage[0].label(), ArgLabel::Nolabel));
+            for (index, expected_name) in [(1, "named"), (2, "optional")] {
+                let label = match (index, stage[index].label()) {
+                    (1, ArgLabel::Labelled(label)) | (2, ArgLabel::Optional(label)) => label,
+                    _ => panic!("label kind"),
+                };
+                assert_eq!(label.txt, expected_name);
+                for (actual, expected) in [(label.loc.loc_start, loc.loc_start), (label.loc.loc_end, loc.loc_end)] {
+                    assert_eq!(actual.file_name, expected.file_name);
+                    assert_eq!(actual.line, expected.line);
+                    assert_eq!(actual.bol, expected.bol);
+                    assert_eq!(actual.cnum, expected.cnum);
+                }
+                assert_eq!(label.loc.loc_ghost, loc.loc_ghost);
+            }
+            assert!(stage.iter().all(|a| a.typ == expected_type));
+        }
+        parameters[1] = TypeArg::unlabeled(ctx.new_var(None));
+        assert!(matches!(declared[1].label(), ArgLabel::Labelled(label) if label.txt == "named"));
+        assert_eq!(declared[1].typ, shared);
+    }
