+    #[test]
+    fn snapshot_projection_subst_row_metadata_and_shared_cycle() {
+        use crate::types::type_expr::RowField;
+        let ctx = TypeContext::new(std::sync::Arc::new(IdGenerator::new()));
+        let cycle = ctx.new_generic_var(None);
+        let more = ctx.new_generic_var(Some("more".into()));
+        let path = Path::pident(Ident::create_persistent("RowName"));
+        ctx.set_desc(cycle, TypeDesc::Tvariant(RowDesc {
+            row_fields: vec![("Z".into(), RowField::Rpresent(Some(cycle))),
+                             ("A".into(), RowField::Rpresent(None))],
+            row_more: more,
+            row_closed: true,
+            row_fixed: false,
+            row_name: Some((path.clone(), vec![cycle, more])),
+        }));
+        let copied = subst_identity_copy(&ctx, cycle);
+        assert_ne!(copied, cycle);
+        {
+            let desc = ctx.borrow_desc(copied);
+            let TypeDesc::Tvariant(row) = &*desc else { panic!("row") };
+            assert!(row.row_closed);
+            assert!(!row.row_fixed);
+            assert_eq!(row.row_fields.len(), 2);
+            assert_eq!(row.row_fields[0].0.as_str(), "Z");
+            assert_eq!(row.row_fields[1].0.as_str(), "A");
+            assert!(matches!(row.row_fields[0].1, RowField::Rpresent(Some(t)) if ctx.repr(t) == copied));
+            assert!(matches!(row.row_fields[1].1, RowField::Rpresent(None)));
+            let (name, args) = row.row_name.as_ref().expect("name");
+            assert!(name.same(&path));
+            assert_eq!(ctx.repr(args[0]), copied);
+            let marker = ctx.borrow_desc(args[1]);
+            let TypeDesc::Ttuple(children) = &*marker else { panic!("row marker tuple") };
+            assert_eq!(children.as_slice(), &[row.row_more, copied]);
+            assert_ne!(row.row_more, more);
+        }
+        ctx.set_desc(copied, TypeDesc::Tnil);
+        assert!(matches!(&*ctx.borrow_desc(cycle), TypeDesc::Tvariant(_)));
+        assert!(matches!(&*ctx.borrow_desc(more), TypeDesc::Tvar(Some(name)) if name == "more"));
+    }
+
+    #[test]
+    fn snapshot_projection_lower_args_cyclic_arrow_mutates_after_projection() {
+        use crate::types::TypeArg;
+        let ctx = TypeContext::new(std::sync::Arc::new(IdGenerator::new()));
+        let env = Env::empty();
+        let first = ctx.new_generic_var(Some("first".into()));
+        let second = ctx.new_generic_var(Some("second".into()));
+        let arrow = ctx.new_generic_var(None);
+        ctx.set_desc(arrow, TypeDesc::Tarrow {
+            args: vec![TypeArg::unlabeled(first), TypeArg::unlabeled(second)], ret: arrow,
+        });
+        let paths = lower_args(&ctx, &env, arrow);
+        assert!(paths.0.is_empty() && paths.1.is_empty());
+        assert_eq!(ctx.get_level(first), ctx.current_level());
+        assert_eq!(ctx.get_level(second), ctx.current_level());
+        ctx.set_desc(arrow, TypeDesc::Tnil);
+    }
