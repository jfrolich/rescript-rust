+    #[test]
+    fn snapshot_projection_subst_identity_and_cyclic_stub() {
+        let ctx = TypeContext::new(std::sync::Arc::new(IdGenerator::new()));
+        let variable = ctx.new_var(Some("variable".into()));
+        let universal = ctx.new_type(TypeDesc::Tunivar(Some("universal".into())));
+        let nil = ctx.new_type(TypeDesc::Tnil);
+        for ty in [variable, universal, nil] {
+            assert_eq!(subst_identity_copy(&ctx, ty), ty);
+        }
+        let cycle = ctx.new_generic_var(None);
+        ctx.set_desc(cycle, TypeDesc::Ttuple(vec![variable, cycle, variable]));
+        let copied = subst_identity_copy_many(&ctx, &[cycle, cycle]);
+        assert_eq!(copied[0], copied[1]);
+        assert_ne!(copied[0], cycle);
+        assert_eq!(ctx.get_level(copied[0]), GENERIC_LEVEL);
+        {
+            let desc = ctx.borrow_desc(copied[0]);
+            let TypeDesc::Ttuple(children) = &*desc else { panic!("tuple") };
+            assert_eq!(children.as_slice(), &[variable, copied[0], variable]);
+        }
+        ctx.set_desc(copied[0], TypeDesc::Tnil);
+        let desc = ctx.borrow_desc(cycle);
+        let TypeDesc::Ttuple(children) = &*desc else { panic!("source tuple") };
+        assert_eq!(children.as_slice(), &[variable, cycle, variable]);
+    }
