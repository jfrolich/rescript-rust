module Constants = {
  @pure @val external e: float = "Math.E"
  @pure @val external ln2: float = "Math.LN2"
  @pure @val external ln10: float = "Math.LN10"
  @pure @val external log2e: float = "Math.LOG2E"
  @pure @val external log10e: float = "Math.LOG10E"
  @pure @val external pi: float = "Math.PI"
  @pure @val external sqrt1_2: float = "Math.SQRT1_2"
  @pure @val external sqrt2: float = "Math.SQRT2"
}

@pure @val external abs: float => float = "Math.abs"
@pure @val external acos: float => float = "Math.acos"
@pure @val external acosh: float => float = "Math.acosh"
@pure @val external asin: float => float = "Math.asin"
@pure @val external asinh: float => float = "Math.asinh"
@pure @val external atan: float => float = "Math.atan"
@pure @val external atanh: float => float = "Math.atanh"
@pure @val external atan2: (~y: float, ~x: float) => float = "Math.atan2"
@pure @val external cbrt: float => float = "Math.cbrt"
@pure @val external ceil: float => float = "Math.ceil"
@pure @val external cos: float => float = "Math.cos"
@pure @val external cosh: float => float = "Math.cosh"
@pure @val external exp: float => float = "Math.exp"
@pure @val external expm1: float => float = "Math.expm1"
@pure @val external floor: float => float = "Math.floor"
@pure @val external fround: float => float = "Math.fround"
@pure @val external hypot: (float, float) => float = "Math.hypot"
@pure @variadic @val external hypotMany: array<float> => float = "Math.hypot"
@pure @val external log: float => float = "Math.log"
@pure @val external log1p: float => float = "Math.log1p"
@pure @val external log10: float => float = "Math.log10"
@pure @val external log2: float => float = "Math.log2"
@pure @val external min: (float, float) => float = "Math.min"
@pure @variadic @val external minMany: array<float> => float = "Math.min"
@pure @val external max: (float, float) => float = "Math.max"
@pure @variadic @val external maxMany: array<float> => float = "Math.max"
@pure @val external pow: (float, ~exp: float) => float = "Math.pow"
@val external random: unit => float = "Math.random"
@pure @val external round: float => float = "Math.round"
@pure @val external sign: float => float = "Math.sign"
@pure @val external sin: float => float = "Math.sin"
@pure @val external sinh: float => float = "Math.sinh"
@pure @val external sqrt: float => float = "Math.sqrt"
@pure @val external tan: float => float = "Math.tan"
@pure @val external tanh: float => float = "Math.tanh"
@pure @val external trunc: float => float = "Math.trunc"

module Int = {
  @pure @val external abs: int => int = "Math.abs"
  @pure @val external clz32: int => int = "Math.clz32"
  @pure @val external imul: (int, int) => int = "Math.imul"
  @pure @val external min: (int, int) => int = "Math.min"
  @pure @variadic @val external minMany: array<int> => int = "Math.min"
  @pure @val external max: (int, int) => int = "Math.max"
  @pure @variadic @val external maxMany: array<int> => int = "Math.max"
  @pure @val external pow: (int, ~exp: int) => int = "Math.pow"
  @pure @val external sign: int => int = "Math.sign"
  let floor: float => int = f => f->floor->Stdlib_Float.toInt
  let ceil: float => int = f => f->ceil->Stdlib_Float.toInt

  let random: (int, int) => int = (min, max) =>
    floor(random() *. Stdlib_Int.toFloat(max - min)) + min
}
