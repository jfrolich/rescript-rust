     // lam_compile_main.ml:212, lam_coercion.ml:196
     let lam = handle_exports(a, &mut meta, lam);
+    // Measurement prototype: one line per top-level binding after the passes.
+    if let Some(path) = std::env::var_os("RESCRIPT_DERIVED_POSTPASS") {
+        use std::io::Write;
+        let mut out = Vec::new();
+        let mut cursor = lam;
+        loop {
+            match a.node(cursor) {
+                Node::Let { id, value, body, .. } => {
+                    let mut text = Vec::new();
+                    crate::lambda::printlambda::print_lambda(&a.export(value), &mut text);
+                    let text = String::from_utf8_lossy(&text).replace('\n', " ");
+                    writeln!(out, "B\t{}\t{}", a.ident(id).name(), text).unwrap();
+                    cursor = body;
+                }
+                Node::LetRec { ids, values, body } => {
+                    let values = a.list_vec(values);
+                    let ids = a.ident_run(ids, values.len()).to_vec();
+                    for (id, value) in ids.iter().zip(values) {
+                        let mut text = Vec::new();
+                        crate::lambda::printlambda::print_lambda(&a.export(value), &mut text);
+                        let text = String::from_utf8_lossy(&text).replace('\n', " ");
+                        writeln!(out, "B\t{}\t{}", id.name(), text).unwrap();
+                    }
+                    cursor = body;
+                }
+                Node::Sequence(_, body) => cursor = body,
+                _ => break,
+            }
+        }
+        std::fs::OpenOptions::new().create(true).append(true).open(path).unwrap().write_all(&out).unwrap();
+    }
