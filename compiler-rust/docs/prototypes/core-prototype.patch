+/// Elements of a recycled first chunk: each element type has its own
+/// per-thread list of first chunks.
+pub(crate) trait ListElem: Copy + 'static {
+    const FILL: Self;
+    fn first_chunk() -> std::rc::Rc<[Cell<Self>; LIST_FIRST_LEN]>;
+}
+
+pub(crate) const LIST_FIRST_LEN: usize = 1 << 16;
+
+fn lease_first_chunk<T: ListElem>(
+    chunks: &RefCell<Vec<std::rc::Rc<[Cell<T>; LIST_FIRST_LEN]>>>,
+) -> std::rc::Rc<[Cell<T>; LIST_FIRST_LEN]> {
+    let mut chunks = chunks.borrow_mut();
+    if let Some(free) = chunks.iter().find(|chunk| std::rc::Rc::strong_count(chunk) == 1) {
+        return std::rc::Rc::clone(free);
+    }
+    let chunk: std::rc::Rc<[Cell<T>]> = (0..LIST_FIRST_LEN).map(|_| Cell::new(T::FILL)).collect();
+    let chunk: std::rc::Rc<[Cell<T>; LIST_FIRST_LEN]> = match chunk.try_into() {
+        Ok(chunk) => chunk,
+        Err(_) => unreachable!(),
+    };
+    chunks.push(std::rc::Rc::clone(&chunk));
+    chunk
+}
