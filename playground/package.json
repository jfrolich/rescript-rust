{
  "name": "rescript-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run prebuild:examples && vite",
    "build": "npm run prebuild:examples && vite build",
    "bundle:stdlib": "node scripts/bundle-stdlib.js",
    "build:wasm": "cd crate && wasm-pack build --target web --release",
    "smoke": "node scripts/bundle-stdlib.js && node scripts/smoke.mjs",
    "preview": "vite preview",
    "prebuild:examples": "node scripts/bundle-stdlib.js && node scripts/prebuild-examples.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^6.0.0",
    "vite-plugin-wasm": "^3.4.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@monaco-editor/react": "^4.7.0",
    "codemirror": "^6.0.2",
    "marked": "^18.2.0",
    "monaco-editor": "^0.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
